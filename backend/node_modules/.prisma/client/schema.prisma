datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// =========================
// ENUMS
// =========================

enum UserRole {
  ADMIN
  OWNER
  PROJECT_MANAGER
  SITE_ENGINEER
  SUPERVISOR
  HSE_OFFICER
  STORE_MANAGER
  CONTRACTOR
  WORKER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

enum WorkerType {
  PERMANENT
  CONTRACT
  DAILY_WAGE
  VISITOR
}

enum InventoryTransactionType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

// =========================
// USERS
// =========================

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String?
  phone     String?
  role      UserRole @default(WORKER)
  avatarUrl String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectsCreated    Project[]       @relation("ProjectCreator")
  projectMemberships ProjectMember[]

  tasksAssigned Task[] @relation("TaskAssignee")
  tasksCreated  Task[] @relation("TaskCreator")

  notifications Notification[]
  auditLogs     AuditLog[]

  worker Worker?

  @@map("users")
}

// =========================
// PROJECTS
// =========================

model Project {
  id String @id @default(uuid())

  name        String
  description String?
  location    String?

  startDate DateTime?
  endDate   DateTime?

  budget Float?

  status ProjectStatus @default(PLANNING)

  createdById String
  createdBy   User   @relation("ProjectCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    ProjectMember[]
  workers    Worker[]
  tasks      Task[]
  attendance Attendance[]

  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]

  incidents   Incident[]
  contractors Contractor[]
  assets      Asset[]

  @@map("projects")
}

// =========================
// PROJECT MEMBERS
// =========================

model ProjectMember {
  id String @id @default(uuid())

  userId    String
  projectId String

  role UserRole

  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("project_members")
}

// =========================
// WORKERS
// =========================

model Worker {
  id String @id @default(uuid())

  employeeCode String? @unique

  name  String
  phone String?
  email String?

  workerType WorkerType @default(CONTRACT)

  designation String?
  department  String?

  dailyWage Float?

  isActive Boolean @default(true)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance Attendance[]

  @@map("workers")
}

// =========================
// CONTRACTORS
// =========================

model Contractor {
  id String @id @default(uuid())

  name        String
  companyName String?

  contactPerson String?
  phone         String?
  email         String?

  address String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workers Worker[]

  @@map("contractors")
}

// =========================
// ATTENDANCE
// =========================

model Attendance {
  id String @id @default(uuid())

  workerId String
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  date DateTime

  checkIn  DateTime?
  checkOut DateTime?

  status AttendanceStatus @default(PRESENT)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerId, projectId, date])
  @@map("attendance")
}

// =========================
// TASKS
// =========================

model Task {
  id String @id @default(uuid())

  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  progress Int @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id])

  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}

// =========================
// INVENTORY
// =========================

model InventoryItem {
  id String @id @default(uuid())

  name        String
  description String?
  sku         String?

  category String?
  unit     String  @default("PCS")

  quantity     Float @default(0)
  minimumStock Float @default(0)

  unitPrice Float?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions InventoryTransaction[]

  @@unique([projectId, sku])
  @@map("inventory_items")
}

// =========================
// INVENTORY TRANSACTIONS
// =========================

model InventoryTransaction {
  id String @id @default(uuid())

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type InventoryTransactionType

  quantity Float

  notes String?

  createdAt DateTime @default(now())

  @@map("inventory_transactions")
}

// =========================
// ASSETS / EQUIPMENT
// =========================

model Asset {
  id String @id @default(uuid())

  name      String
  assetCode String?

  category String?

  status String @default("AVAILABLE")

  purchaseDate  DateTime?
  lastServiceAt DateTime?
  nextServiceAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assets")
}

// =========================
// HSE / INCIDENTS
// =========================

model Incident {
  id String @id @default(uuid())

  title       String
  description String?

  location String?

  severity IncidentSeverity @default(LOW)
  status   IncidentStatus   @default(OPEN)

  incidentDate DateTime

  imageUrl String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("incidents")
}

// =========================
// NOTIFICATIONS
// =========================

model Notification {
  id String @id @default(uuid())

  title   String
  message String

  type NotificationType @default(INFO)

  isRead Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("notifications")
}

// =========================
// AUDIT LOGS
// =========================

model AuditLog {
  id String @id @default(uuid())

  action   String
  entity   String
  entityId String?

  oldData Json?
  newData Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@map("audit_logs")
}
